# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# The pruned catalogue's working set (scripts/catalogue/prune.mjs):
#   catalogue/exercises-archive/  what the prune moved aside — recoverable, never shipped
#   catalogue/test-fixtures/      the exercises the test suite needs (gitignored: upstream
#                                 data kept for the tests, not part of the app's catalogue)
#   catalogue/media-fixtures/     their stills and animations
#   exports/                      .ogex files written by scripts/export-exercises.mjs
catalogue/exercises-archive/
catalogue/test-fixtures/
catalogue/media-fixtures/
exports/


# Release signing key and its password (never committed)
keystore/
out/